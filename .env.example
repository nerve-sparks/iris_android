# Copy this file to .env and fill in your keys
# cp .env.example .env

# ── Required ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Image generation (choose one) ────────────────────────────────────────────
OPENAI_API_KEY=sk-...              # for DALL-E 3
# BANANA_API_KEY=...               # for Banana.dev / Stable Diffusion
# BANANA_MODEL_KEY=...

# ── Audio / TTS ──────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=...             # for ElevenLabs TTS
SUNO_API_KEY=...                   # for Suno music generation
SUNO_API_BASE_URL=http://localhost:3000  # suno-api local instance

# ── Output ───────────────────────────────────────────────────────────────────
AGENT_OUTPUT_DIR=./agent_output
