<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Samsung Galaxy S24 Ultra optimized app shortcuts -->
    <shortcut
        android:shortcutId="new_chat"
        android:enabled="true"
        android:icon="@drawable/logo"
        android:shortcutShortLabel="@string/shortcut_new_chat_short"
        android:shortcutLongLabel="@string/shortcut_new_chat_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.nervesparks.iris"
            android:targetClass="com.nervesparks.iris.MainActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    
    <shortcut
        android:shortcutId="voice_chat"
        android:enabled="true"
        android:icon="@drawable/mic_on_svgrepo_com"
        android:shortcutShortLabel="@string/shortcut_voice_chat_short"
        android:shortcutLongLabel="@string/shortcut_voice_chat_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.nervesparks.iris"
            android:targetClass="com.nervesparks.iris.MainActivity">
            <extra android:name="action" android:value="voice_chat" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    
    <shortcut
        android:shortcutId="models"
        android:enabled="true"
        android:icon="@drawable/data_exploration_models_svgrepo_com"
        android:shortcutShortLabel="@string/shortcut_models_short"
        android:shortcutLongLabel="@string/shortcut_models_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.nervesparks.iris"
            android:targetClass="com.nervesparks.iris.MainActivity">
            <extra android:name="action" android:value="models" />
        </intent>
    </shortcut>
    
</shortcuts>